rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile rule: users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Documents rule: users can only read, create, update, and delete their own documents
    match /documents/{documentId} {
      allow read, update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }
  }
}
